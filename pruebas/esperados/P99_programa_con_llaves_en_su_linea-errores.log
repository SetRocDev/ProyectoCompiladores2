0001 <?php
0002 // Sistema simple de gestión de notas
0003 
0004 # Datos del estudiante
0005 $nombre_estudiante = "Carlos";
0006 $cantidad_notas = 4;
0007 
0008 // Arreglo de notas
0009 $notas = array(85, 90, 78, 92);
0010 
0011 // Mostrar información inicial
0012 echo "Estudiante: $nombre_estudiante\n";
0013 echo "Cantidad de notas: $cantidad_notas\n";
0014 
0015 // Calcular promedio usando for
0016 $suma_notas = 0;
0017 
0018 for ($i = 0; $i < $cantidad_notas; $i = $i + 1)
0019 {
0020     $suma_notas = $suma_notas + $notas[$i];
0021 }
0022 
0023 $promedio = $suma_notas / $cantidad_notas;
0024 
0025 // Mostrar promedio
0026 echo "Promedio: $promedio\n";
0027 
0028 // Evaluar estado del estudiante
0029 if ($promedio >= 70)
0030 {
0031     echo "Estado: Aprobado\n";
0032 }
0033 else
0034 {
0035     echo "Estado: Reprobado\n";
0036 }
0037 
0038 // Contador de revisión usando while
0039 $contador_revision = 0;
0040 
0041 while ($contador_revision < $cantidad_notas)
0042 {
0043     echo "Revisando nota: " . $notas[$contador_revision] . "\n";
0044     $contador_revision = $contador_revision + 1;
0045 }
0046 
0047 // Información adicional
0048 $mensaje_final = "Proceso finalizado correctamente";
0049 echo $mensaje_final;
0050 
0051 // Diferenciación de identificadores
0052 $total = 100;
0053 $Total = 200;
0054 
0055 $resultado = $total + $Total;
0056 echo "\nResultado final: $resultado\n";
0057 
0058 ?>