# Codigo fuente y documentacion: normalizar saltos de linea
*.java text
*.txt  text eol=crlf
*.md   text
*.xml  text
*.properties text

# Los archivos .php son datos de prueba del analizador lexico: se guardan
# byte a byte (sin convertir CRLF/LF ni agregar salto de linea final),
# porque el formato exacto es parte de lo que se evalua (R1, R2, R4).
# Van al final para que tengan prioridad sobre la regla *.txt.
*.php -text
*.PHP -text
*.php.txt -text

# Los .log esperados de las pruebas se comparan byte por byte con los que genera
# el programa: se guardan tal cual (sin convertir saltos de línea).
pruebas/esperados/*.log -text
pruebas/catedra/esperados/*.log -text

# Scripts de pruebas: el .bat necesita CRLF (Windows) y el .sh necesita LF (Linux)
*.bat text eol=crlf
*.sh  text eol=lf

# El programa compilado (.jar) se guarda tal cual
*.jar binary
